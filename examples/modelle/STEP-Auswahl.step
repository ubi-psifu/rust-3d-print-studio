#3208 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#3205,
  'distance_accuracy_value','confusion accuracy');
#3209 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#3007));
ENDSEC;
